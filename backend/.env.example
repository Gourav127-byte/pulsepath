APP_NAME=PulsePath API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/pulsepath
# Optional override for pytest. The database name must end with _test.
# If omitted, pytest derives pulsepath_test from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/pulsepath_test
# DEV-ONLY. Generate and configure a strong secret before any production build.
JWT_SECRET=DEV-ONLY-pulsepath-change-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
# DEV/TEST-only manual verification switch. Must remain false in production.
EXPOSE_PASSWORD_RESET_TOKEN=false
# Optional JSON array of origins for web CORS (e.g. '["https://app.pulsepath.com"]')
# Leave empty for mobile-only API deployment.
CORS_ALLOWED_ORIGINS=[]
